{
  "name": "vision-omie-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Middleware de integração Vision ERP ↔ Omie ERP (pedidos de venda, ordens de serviço, retorno fiscal e financeiro)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "simulators": "tsx scripts/simulators/start.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "users:create": "tsx scripts/users-create.ts",
    "deps:up": "docker compose -f docker/compose.yaml up -d --wait",
    "deps:down": "docker compose -f docker/compose.yaml down",
    "app:up": "docker compose -f docker/compose.yaml --profile app up -d --build --wait",
    "app:down": "docker compose -f docker/compose.yaml --profile app down"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
