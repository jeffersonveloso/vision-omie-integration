# ─────────────────────────────────────────────────────────────
# Vision ↔ Omie — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione credenciais.
# ─────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL). Se vazio, usa PGlite embarcado em ./.data/pglite (somente dev/teste).
DATABASE_URL=
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/vision_omie

# Chave de 32 bytes (base64) usada para criptografar o App Secret das contas Omie.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Fuso usado para datas de filtro (Vision) e datas enviadas ao Omie (dd/mm/aaaa)
APP_TIMEZONE=America/Sao_Paulo

# ControllerAPI do Vision (Ecolife)
VISION_API_URL=http://179.108.107.158:8000/ControllerAPI
VISION_USERNAME=
VISION_PASSWORD=

# API Omie (padrão oficial). Para usar os simuladores locais: http://localhost:4020/api/v1
OMIE_API_URL=https://app.omie.com.br/api/v1
# Cache (ms) de consultas idênticas ao Omie. O Omie bloqueia a mesma consulta repetida em menos de 60 s.
OMIE_READ_CACHE_MS=55000

# Primeira coleta: quantos dias para trás buscar pedidos atualizados no Vision.
# É o valor inicial; depois de salvar a tela de Configurações, vale o que estiver lá.
# Para buscar de novo depois que a coleta começou: Configurações › Coleta › "Recomeçar a coleta".
SYNC_INITIAL_LOOKBACK_DAYS=7

# Agendador interno (cron). Desligue se a execução for disparada por um cron externo.
SCHEDULER_ENABLED=true

# Token exigido em /api/webhooks/omie?token=... (opcional; sem token o webhook fica desativado)
OMIE_WEBHOOK_TOKEN=
