# Opcional: copie para docker/.env para trocar os valores padrão do docker/compose.yaml.
# Se mudar usuário, senha, banco ou portas, ajuste DATABASE_URL e REDIS_URL no .env.local da aplicação.
# Num servidor de homologação compartilhado, troque a senha do PostgreSQL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vision_omie
POSTGRES_PORT=5432

REDIS_PORT=6379
