# Variáveis da aplicação dentro do Docker (perfil "app" do docker/compose.yaml).
# Copie para docker/app.env e preencha. Nunca versione o docker/app.env.
# DATABASE_URL, REDIS_URL e WEBHOOK_WORKER_ENABLED são definidos pelo compose.

# 32 bytes em base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não pode mudar depois do cadastro das contas Omie.
APP_ENCRYPTION_KEY=
APP_TIMEZONE=America/Sao_Paulo
# Endereço público (links dos alertas). Ex.: https://integracao.ecolife.com.br
APP_BASE_URL=

# ControllerAPI do Vision
VISION_API_URL=
VISION_USERNAME=
VISION_PASSWORD=

OMIE_API_URL=https://app.omie.com.br/api/v1
OMIE_WEBHOOK_TOKEN=
SYNC_INITIAL_LOOKBACK_DAYS=7
SLACK_WEBHOOK_URL=

# Login próprio: o primeiro administrador é criado no primeiro início (só se ainda não houver usuários).
AUTH_MODE=local
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_NAME=
# Token para cron externo e scripts (Authorization: Bearer ...), 32+ caracteres. Opcional.
AUTH_API_TOKEN=
